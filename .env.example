# Пример переменных окружения для Telegram-бота и серверных функций.
# Реальные значения задаются в Vercel → Settings → Environment Variables.
# НИКОГДА не коммитьте реальный токен — .env в .gitignore.

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-botfather
TELEGRAM_CHAT_ID=123456789
# Опционально: отдельный чат для служебных алертов о здоровье парсера
# (источник перестал парситься / восстановился). Пусто — алерты выключены.
# TELEGRAM_ADMIN_CHAT_ID=123456789

# Защита /api/notify. Vercel Cron подставляет его сам (Authorization: Bearer),
# внешний пингер ходит с ?key=. БЕЗ него на Vercel endpoint отвечает 401
# (GH Actions-пингер работает и так — через OIDC, секрет ему не нужен).
CRON_SECRET=any-random-string

# Секрет webhook'а бота (/api/telegram): Telegram шлёт его в каждом апдейте
# заголовком X-Telegram-Bot-Api-Secret-Token после регистрации через
# GET /api/telegram?setup=<этот секрет>.
TELEGRAM_WEBHOOK_SECRET=another-random-string

# Ключ синка смен (/api/shifts-sync): тот же ключ вводится в настройках
# приложения — тогда уведомления получают пометку «⚠️ ваша смена».
# SHIFTS_SYNC_KEY=yet-another-random-string

# 'off' выключает утренний дайджест (по умолчанию включён, 07:50–08:35 Минска).
# TELEGRAM_DIGEST=off

# Адрес приложения для inline-кнопки «Открыть приложение» и регистрации
# webhook'а. Пусто — берётся хост запроса / адрес по умолчанию.
# APP_URL=https://raspisanie-polessu-v2.vercel.app

# BLOB_READ_WRITE_TOKEN подставляется Vercel автоматически при подключении Blob
